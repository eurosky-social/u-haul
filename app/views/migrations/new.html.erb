<% content_for :title do %><%= EuroskyConfig::SITE_NAME %> - <%= t('migrations.new.page_title') %><% end %>

<% content_for :head do %>
<style>
  body {
    margin: 0;
    padding: 0;
    <% if EuroskyConfig::BACKGROUND_IMAGE_URL.present? %>
    background: url('<%= EuroskyConfig::BACKGROUND_IMAGE_URL %>') no-repeat center center fixed;
    background-size: cover;
    <% else %>
    background: var(--gradient);
    <% end %>
    display: flex;
    align-items: center;
    justify-content: center;
  }

  <% if EuroskyConfig::BACKGROUND_IMAGE_URL.present? %>
  body::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.4);
    z-index: 0;
  }
  <% end %>

  .new-migration-container {
    position: relative;
    z-index: 1;
    max-width: 800px;
    width: 95%;
    margin: 40px auto;
  }

  .new-migration-content {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px) saturate(180%);
    border-radius: 1.5rem;
    padding: 3rem;
    padding-top: 0;
    border: 1px solid rgba(255, 255, 255, 0.3);
    box-shadow: 0 15px 30px -5px rgba(0, 0, 0, 0.1), 0 5px 15px -5px rgba(0, 0, 0, 0.05);
  }

  .new-migration-header {
    text-align: center;
    margin-bottom: 2rem;
    padding: 2rem 3rem;
    background: #ffffff;
    border-radius: 1rem;
  }

  .new-migration-header h1 {
    font-size: 72px;
    font-weight: 900;
    color: #000000;
    margin: 0 0 8px 0;
    letter-spacing: -2px;
    font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "Arial Black", sans-serif;
  }

  .new-migration-header p {
    font-size: 14px;
    color: #000000;
    margin: 0;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  .handle-suffix {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: #999;
    pointer-events: none;
  }

  .typeahead-wrapper {
    position: relative;
  }

  .typeahead-dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 1050;
    background: #fff;
    border: 1px solid #dee2e6;
    border-top: none;
    border-radius: 0 0 0.5rem 0.5rem;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.12);
    max-height: 280px;
    overflow-y: auto;
    display: none;
  }

  .typeahead-dropdown.active {
    display: block;
  }

  .typeahead-item {
    display: flex;
    align-items: center;
    padding: 8px 12px;
    cursor: pointer;
    gap: 10px;
    transition: background 0.1s;
  }

  .typeahead-item:hover,
  .typeahead-item.highlighted {
    background: #f0f4ff;
  }

  .typeahead-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    background: #e9ecef;
  }

  .typeahead-info {
    min-width: 0;
    flex: 1;
  }

  .typeahead-displayname {
    font-weight: 600;
    font-size: 14px;
    color: #1a1a1a;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .typeahead-handle {
    font-size: 13px;
    color: #666;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .typeahead-loading {
    padding: 12px;
    text-align: center;
    color: #999;
    font-size: 13px;
  }
</style>
<% end %>

<% content_for :scripts do %>
<script>
  // Translations for JavaScript
  var I18n = <%= raw t('migrations.js').to_json %>;
  function i18n(key, vars) {
    var str = I18n[key] || key;
    if (vars) Object.entries(vars).forEach(function(e) { str = str.replace('{' + e[0] + '}', e[1]); });
    return str;
  }

  document.addEventListener('DOMContentLoaded', function() {
    const form = document.querySelector('form');

    // Form fields
    const handleField = document.getElementById('migration_old_handle');
    const passwordField = document.getElementById('migration_password');
    const emailField = document.getElementById('migration_email');
    const pdsSelect = document.getElementById('pds-select');
    const customPdsField = document.getElementById('migration_new_pds_host');
    const inviteCodeField = document.getElementById('migration_invite_code');

    // Steps
    const step1 = document.getElementById('step-1');
    const step2 = document.getElementById('step-2');
    const step3 = document.getElementById('step-3');
    const step4 = document.getElementById('step-4');
    const step5 = document.getElementById('step-5');

    // Wizard state
    let wizardData = {
      email: null,
      emailReadonly: false,
      authenticated: false,
      pdsHost: null,
      pdsVerified: false,
      pdsVerifiedHost: null,
      availableDomains: [],
      handleType: null,
      canPreserveHandle: false,
      oldHandle: null,
      handleVerifiedVia: null
    };

    // Progress indicators
    const progress1 = document.getElementById('progress-1');
    const progress2 = document.getElementById('progress-2');
    const progress3 = document.getElementById('progress-3');
    const progress4 = document.getElementById('progress-4');
    const progress5 = document.getElementById('progress-5');
    const progressBar = document.getElementById('progress-bar');

    // Configuration from server
    const defaultTargetPds = '<%= EuroskyConfig::DEFAULT_TARGET_PDS %>';

    // Initialize
    showStep(1);

    // ── Handle Typeahead ──
    (function() {
      let debounceTimer = null;
      let highlightIndex = -1;
      let currentActors = [];

      // Create dropdown container
      const dropdown = document.createElement('div');
      dropdown.className = 'typeahead-dropdown';
      dropdown.id = 'handle-typeahead';
      handleField.parentNode.classList.add('typeahead-wrapper');
      handleField.parentNode.appendChild(dropdown);
      handleField.setAttribute('autocomplete', 'off');

      function hideDropdown() {
        dropdown.classList.remove('active');
        dropdown.innerHTML = '';
        highlightIndex = -1;
        currentActors = [];
      }

      function selectActor(handle) {
        handleField.value = handle;
        hideDropdown();
        handleField.focus();
      }

      function renderActors(actors) {
        currentActors = actors;
        highlightIndex = -1;

        if (actors.length === 0) {
          hideDropdown();
          return;
        }

        dropdown.innerHTML = actors.map(function(actor, idx) {
          const avatarHtml = actor.avatar
            ? '<img class="typeahead-avatar" src="' + actor.avatar + '" alt="" loading="lazy">'
            : '<div class="typeahead-avatar"></div>';
          const nameHtml = actor.display_name
            ? '<div class="typeahead-displayname">' + escapeHtml(actor.display_name) + '</div>'
            : '';
          return '<div class="typeahead-item" data-index="' + idx + '">'
            + avatarHtml
            + '<div class="typeahead-info">'
            + nameHtml
            + '<div class="typeahead-handle">@' + escapeHtml(actor.handle) + '</div>'
            + '</div></div>';
        }).join('');

        dropdown.classList.add('active');

        // Attach click handlers
        dropdown.querySelectorAll('.typeahead-item').forEach(function(item) {
          item.addEventListener('mousedown', function(e) {
            e.preventDefault();
            var idx = parseInt(item.dataset.index);
            selectActor(currentActors[idx].handle);
          });
        });
      }

      function updateHighlight() {
        dropdown.querySelectorAll('.typeahead-item').forEach(function(item, idx) {
          item.classList.toggle('highlighted', idx === highlightIndex);
        });
        if (highlightIndex >= 0) {
          var el = dropdown.querySelector('.typeahead-item.highlighted');
          if (el) el.scrollIntoView({ block: 'nearest' });
        }
      }

      function escapeHtml(str) {
        var div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
      }

      function fetchActors(query) {
        dropdown.innerHTML = '<div class="typeahead-loading">' + i18n('typeahead_searching') + '</div>';
        dropdown.classList.add('active');

        fetch('/migrations/search_actors?q=' + encodeURIComponent(query) + '&limit=8')
          .then(function(r) { return r.json(); })
          .then(function(data) {
            // Only update if input still matches (user may have typed more)
            if (handleField.value.trim().toLowerCase() === query.toLowerCase() ||
                handleField.value.trim().toLowerCase().startsWith(query.toLowerCase())) {
              renderActors(data.actors || []);
            }
          })
          .catch(function() { hideDropdown(); });
      }

      handleField.addEventListener('input', function() {
        var val = handleField.value.trim();
        clearTimeout(debounceTimer);

        if (val.length < 2 || handleField.readOnly) {
          hideDropdown();
          return;
        }

        debounceTimer = setTimeout(function() { fetchActors(val); }, 250);
      });

      handleField.addEventListener('keydown', function(e) {
        if (!dropdown.classList.contains('active') || currentActors.length === 0) return;

        if (e.key === 'ArrowDown') {
          e.preventDefault();
          highlightIndex = Math.min(highlightIndex + 1, currentActors.length - 1);
          updateHighlight();
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          highlightIndex = Math.max(highlightIndex - 1, 0);
          updateHighlight();
        } else if (e.key === 'Enter' && highlightIndex >= 0) {
          e.preventDefault();
          selectActor(currentActors[highlightIndex].handle);
        } else if (e.key === 'Escape') {
          hideDropdown();
        }
      });

      handleField.addEventListener('blur', function() {
        // Small delay to allow click on dropdown item
        setTimeout(hideDropdown, 200);
      });

      handleField.addEventListener('focus', function() {
        var val = handleField.value.trim();
        if (val.length >= 2 && currentActors.length > 0 && !handleField.readOnly) {
          dropdown.classList.add('active');
        }
      });
    })();

    // Pre-select default target PDS if configured
    if (defaultTargetPds && pdsSelect) {
      const option = Array.from(pdsSelect.options).find(opt => opt.value === defaultTargetPds);
      if (option) {
        pdsSelect.value = defaultTargetPds;
        customPdsField.value = defaultTargetPds;
      }
    }

    // Show/hide steps
    function showStep(stepNumber) {
      [step1, step2, step3, step4, step5].forEach(s => s.classList.remove('active'));
      [progress1, progress2, progress3, progress4, progress5].forEach(p => p.classList.remove('active', 'completed'));
      progressBar.style.width = ((stepNumber - 1) / 4 * 100) + '%';

      if (stepNumber === 1) {
        step1.classList.add('active');
        progress1.classList.add('active');
      }
      if (stepNumber === 2) {
        step2.classList.add('active');
        progress1.classList.add('completed');
        progress2.classList.add('active');
      }
      if (stepNumber === 3) {
        step3.classList.add('active');
        progress1.classList.add('completed');
        progress2.classList.add('completed');
        progress3.classList.add('active');
      }
      if (stepNumber === 4) {
        step4.classList.add('active');
        progress1.classList.add('completed');
        progress2.classList.add('completed');
        progress3.classList.add('completed');
        progress4.classList.add('active');
      }
      if (stepNumber === 5) {
        step5.classList.add('active');
        [progress1, progress2, progress3, progress4].forEach(p => p.classList.add('completed'));
        progress5.classList.add('active');
      }
    }

    // Utility: Show status message
    function showStatus(element, message, type) {
      element.textContent = message;
      element.className = 'lookup-status lookup-' + type + ' mt-3';
      element.style.display = 'block';
    }

    // STEP 1: Handle & Password
    document.getElementById('step1-next').addEventListener('click', function(e) {
      e.preventDefault();

      const handle = handleField.value.trim();
      const password = passwordField.value.trim();
      const btn = e.target;
      const status = document.getElementById('step1-status');

      if (!handle) {
        showStatus(status, i18n('enter_handle'), 'error');
        return;
      }

      if (!password) {
        showStatus(status, i18n('enter_password'), 'error');
        return;
      }

      if (!handle.includes('.')) {
        showStatus(status, i18n('handle_needs_domain'), 'error');
        return;
      }

      const legalCheckbox = document.getElementById('legal-consent');
      if (!legalCheckbox.checked) {
        showStatus(status, i18n('confirm_legal_consent'), 'error');
        legalCheckbox.focus();
        return;
      }

      // If already authenticated and fields are readonly, proceed to step 2
      if (wizardData.authenticated) {
        showStep(2);
        setupStep2();
        return;
      }

      btn.disabled = true;
      btn.textContent = i18n('authenticating');
      showStatus(status, i18n('authenticating_details'), 'info');

      fetch('/migrations/lookup_handle', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
        },
        body: JSON.stringify({
          handle: handle,
          password: password,
          two_factor_code: document.getElementById('two_factor_code').value.trim() || undefined
        })
      })
      .then(response => response.json())
      .then(data => {
        if (data.two_factor_required) {
          document.getElementById('two-factor-group').style.display = 'block';
          document.getElementById('two_factor_code').focus();
          showStatus(status, i18n('two_factor_sent'), 'info');
          btn.disabled = false;
          btn.textContent = i18n('continue');
          return;
        }

        if (data.error) {
          showStatus(status, data.error, 'error');
          btn.disabled = false;
          btn.textContent = i18n('continue');
          return;
        }

        showStatus(status, i18n('auth_success'), 'success');

        // Store email data and mark as authenticated
        wizardData.authenticated = true;
        if (data.email) {
          wizardData.email = data.email;
          wizardData.emailReadonly = true;
        } else {
          wizardData.email = '';
          wizardData.emailReadonly = false;
        }

        // Store DID, source PDS, and authentication tokens
        wizardData.did = data.did;
        wizardData.oldPdsHost = data.pds_host;
        wizardData.accessToken = data.access_token;
        wizardData.refreshToken = data.refresh_token;

        // Store handle type information for step 4
        wizardData.handleType = data.handle_type || 'pds_hosted';
        wizardData.canPreserveHandle = data.can_preserve_handle || false;
        wizardData.oldHandle = handle;
        wizardData.handleVerifiedVia = data.handle_verified_via;

        // Proceed to step 2
        setTimeout(() => {
          handleField.readOnly = true;
          passwordField.readOnly = true;
          btn.disabled = false;
          btn.textContent = i18n('continue');
          showStep(2);
          setupStep2();
        }, 500);
      })
      .catch(error => {
        showStatus(status, i18n('network_error'), 'error');
        btn.disabled = false;
        btn.textContent = i18n('continue');
      });
    });

    // STEP 2: Email
    function setupStep2() {
      emailField.value = wizardData.email || '';
      if (wizardData.emailReadonly) {
        emailField.readOnly = true;
        emailField.classList.add('readonly-field');
        document.querySelector('#step-2 .form-text').textContent = i18n('email_readonly_help');
      } else {
        emailField.readOnly = false;
        emailField.classList.remove('readonly-field');
        document.querySelector('#step-2 .form-text').textContent = i18n('email_manual_help');
        emailField.focus();
      }
    }

    document.getElementById('step2-back').addEventListener('click', function(e) {
      e.preventDefault();
      handleField.readOnly = false;
      passwordField.readOnly = false;
      handleField.classList.remove('readonly-field');
      passwordField.classList.remove('readonly-field');
      wizardData.authenticated = false;
      showStep(1);
    });

    document.getElementById('step2-next').addEventListener('click', function(e) {
      e.preventDefault();

      const email = emailField.value.trim();
      if (!email) {
        alert(i18n('enter_email'));
        return;
      }

      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(email)) {
        alert(i18n('invalid_email'));
        return;
      }

      const confirmCheckbox = document.getElementById('confirm-email-access');
      if (!confirmCheckbox.checked) {
        alert(i18n('confirm_email_access'));
        confirmCheckbox.focus();
        return;
      }

      wizardData.email = email;
      emailField.readOnly = true;
      showStep(3);
      setupStep3();
    });

    // STEP 3: PDS Selection
    function setupStep3() {
      if (defaultTargetPds && pdsSelect.value === defaultTargetPds) {
        const status = document.getElementById('pds-status');
        const inviteGroup = document.getElementById('invite-code-group');
        checkPdsRequirements(defaultTargetPds, status, inviteGroup, function(success) {
          if (success) {
            checkAccountExistsOnTarget(defaultTargetPds, function(exists) {
              if (exists) {
                showTargetPasswordSection(defaultTargetPds);
              }
            });
          }
        });
      }
    }

    document.getElementById('step3-back').addEventListener('click', function(e) {
      e.preventDefault();
      if (!wizardData.emailReadonly) {
        emailField.readOnly = false;
      }
      showStep(2);
    });

    function checkPdsConsentBeforeProceeding() {
      var step3Error = document.getElementById('step3-error');
      // Only require consent checkbox for Eurosky PDSs
      if (!wizardData.pdsIsEurosky) {
        step3Error.style.display = 'none';
        return true;
      }
      var consentGroup = document.getElementById('pds-consent-group');
      if (consentGroup.style.display === 'none') {
        step3Error.style.display = 'none';
        return true;
      }
      var checkbox = document.getElementById('pds-consent-checkbox');
      if (checkbox.checked) {
        step3Error.style.display = 'none';
        return true;
      }
      showStatus(step3Error, i18n('pds_consent_required'), 'error');
      consentGroup.scrollIntoView({ behavior: 'smooth', block: 'center' });
      checkbox.focus();
      return false;
    }

    document.getElementById('step3-next').addEventListener('click', function(e) {
      e.preventDefault();

      const btn = e.target;
      const status = document.getElementById('pds-status');
      const step3Error = document.getElementById('step3-error');
      const inviteGroup = document.getElementById('invite-code-group');
      let selectedPds = pdsSelect.value;

      step3Error.style.display = 'none';

      if (selectedPds === 'custom') {
        selectedPds = customPdsField.value.trim();
      }

      if (!selectedPds || selectedPds === 'custom') {
        showStatus(step3Error, i18n('select_server'), 'error');
        return;
      }

      // For custom PDS: if not yet verified, check requirements first
      if (pdsSelect.value === 'custom' && (!wizardData.pdsVerified || wizardData.pdsVerifiedHost !== selectedPds)) {
        btn.disabled = true;
        btn.textContent = i18n('checking_server');
        checkPdsRequirements(selectedPds, status, inviteGroup, function(success) {
          if (!success) {
            btn.disabled = false;
            btn.textContent = i18n('continue');
            return;
          }

          // After PDS check succeeds, check if account already exists on target
          btn.textContent = i18n('checking_existing');
          checkAccountExistsOnTarget(selectedPds, function(exists) {
            btn.disabled = false;
            btn.textContent = i18n('continue');
            if (exists) {
              showTargetPasswordSection(selectedPds);
              // Stay on step 3 for credential entry
            } else if (inviteCodeField.required) {
              hideTargetPasswordSection();
              showStatus(status, i18n('invite_code_required'), 'info');
              inviteCodeField.focus();
            } else {
              hideTargetPasswordSection();
              if (blockIfCaptchaUnsupported(step3Error)) return;
              if (!checkPdsConsentBeforeProceeding()) return;
              wizardData.pdsHost = selectedPds;
              showStep(4);
              setupStep4();
            }
          });
        });
        return;
      }

      // Check if invite code is required and empty (only for migration_out)
      if (!wizardData.accountExistsOnTarget && inviteCodeField.required && !inviteCodeField.value.trim()) {
        showStatus(step3Error, i18n('enter_invite_code'), 'error');
        inviteCodeField.focus();
        return;
      }

      // If account exists on target, verify credentials before proceeding
      if (wizardData.accountExistsOnTarget) {
        const targetPassword = document.getElementById('target-pds-password').value.trim();
        const targetStatus = document.getElementById('target-password-status');

        if (!targetPassword) {
          showStatus(targetStatus, i18n('enter_target_password'), 'error');
          showStatus(step3Error, i18n('enter_target_password'), 'error');
          return;
        }

        if (wizardData.targetCredentialsVerified) {
          if (!checkPdsConsentBeforeProceeding()) return;
          wizardData.pdsHost = selectedPds;
          showStep(4);
          setupStep4();
          return;
        }

        btn.disabled = true;
        btn.textContent = i18n('verifying_credentials');
        showStatus(targetStatus, i18n('authenticating_existing'), 'info');

        fetch('/migrations/verify_target_credentials', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
          },
          body: JSON.stringify({
            pds_host: selectedPds,
            did: wizardData.did,
            password: targetPassword,
            two_factor_code: document.getElementById('target-2fa-code').value.trim() || undefined
          })
        })
        .then(response => response.json())
        .then(data => {
          btn.disabled = false;
          btn.textContent = i18n('continue');

          if (data.two_factor_required) {
            document.getElementById('target-2fa-group').style.display = 'block';
            document.getElementById('target-2fa-code').focus();
            showStatus(targetStatus, 'A sign-in code has been sent to your email. Enter it above and click Continue again.', 'info');
            return;
          }

          if (data.error) {
            showStatus(targetStatus, data.error, 'error');
            showStatus(step3Error, data.error, 'error');
            return;
          }

          wizardData.targetCredentialsVerified = true;
          wizardData.newPdsAccessToken = data.access_token;
          wizardData.newPdsRefreshToken = data.refresh_token;

          showStatus(targetStatus, i18n('credentials_verified'), 'success');

          setTimeout(() => {
            if (!checkPdsConsentBeforeProceeding()) return;
            wizardData.pdsHost = selectedPds;
            showStep(4);
            setupStep4();
          }, 500);
        })
        .catch(error => {
          btn.disabled = false;
          btn.textContent = i18n('continue');
          showStatus(targetStatus, i18n('network_error'), 'error');
          showStatus(step3Error, i18n('network_error'), 'error');
        });
        return;
      }

      if (blockIfCaptchaUnsupported(step3Error)) return;
      if (!checkPdsConsentBeforeProceeding()) return;
      wizardData.pdsHost = selectedPds;
      showStep(4);
      setupStep4();
    });

    // A server that requires phone/captcha verification without a gatekeeper we can
    // talk to cannot accept account creation from here (createAccount answers
    // "Authentication Required"). Only relevant when no account exists there yet.
    function blockIfCaptchaUnsupported(statusElement) {
      if (wizardData.pdsCaptchaUnsupported && !wizardData.accountExistsOnTarget) {
        showStatus(statusElement, i18n('captcha_unsupported'), 'error');
        return true;
      }
      return false;
    }

    // Check if account already exists on target PDS (replaces old bsky.social-only isMigrationIn check)
    function checkAccountExistsOnTarget(pdsUrl, callback) {
      if (!pdsUrl || !wizardData.did) {
        callback(false);
        return;
      }

      fetch('/migrations/check_did_on_pds', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
        },
        body: JSON.stringify({
          did: wizardData.did,
          pds_host: pdsUrl
        })
      })
      .then(response => response.json())
      .then(data => {
        if (data.exists) {
          wizardData.accountExistsOnTarget = true;
          wizardData.accountDeactivatedOnTarget = data.deactivated || false;
          wizardData.targetPdsSupportEmail = wizardData.pdsContactEmail || null;
          wizardData.existingHandleOnTarget = data.handle || null;
          callback(true, data);
        } else {
          wizardData.accountExistsOnTarget = false;
          wizardData.accountDeactivatedOnTarget = false;
          wizardData.targetPdsSupportEmail = null;
          wizardData.existingHandleOnTarget = null;
          callback(false, data);
        }
      })
      .catch(error => {
        // On error, assume account doesn't exist (proceed with migration_out)
        wizardData.accountExistsOnTarget = false;
        wizardData.accountDeactivatedOnTarget = false;
        wizardData.existingHandleOnTarget = null;
        callback(false);
      });
    }

    function showTargetPasswordSection(pdsUrl) {
      const targetPasswordGroup = document.getElementById('target-password-group');
      const targetPasswordStatus = document.getElementById('target-password-status');
      const deactivatedHelp = document.getElementById('target-deactivated-help');
      const deactivatedPwdLink = document.getElementById('target-deactivated-pwd-link');
      const deactivatedSupportEmail = document.getElementById('target-deactivated-support-email');
      const deactivatedDid = document.getElementById('target-deactivated-did');

      // Hide invite code section - not needed when using existing account
      const inviteGroup = document.getElementById('invite-code-group');
      if (inviteGroup) inviteGroup.style.display = 'none';

      targetPasswordGroup.style.display = 'block';
      wizardData.targetCredentialsVerified = false;
      wizardData.newPdsAccessToken = null;
      wizardData.newPdsRefreshToken = null;
      targetPasswordStatus.style.display = 'none';

      // Show deactivated account help if applicable
      if (deactivatedHelp) {
        if (wizardData.accountDeactivatedOnTarget) {
          deactivatedHelp.style.display = 'block';
          if (deactivatedPwdLink) {
            deactivatedPwdLink.href = pdsUrl.replace(/\/$/, '') + '/.well-known/change-password';
            deactivatedPwdLink.textContent = pdsUrl.replace(/\/$/, '') + '/.well-known/change-password';
          }
          if (deactivatedSupportEmail && wizardData.targetPdsSupportEmail) {
            deactivatedSupportEmail.href = 'mailto:' + wizardData.targetPdsSupportEmail;
            deactivatedSupportEmail.textContent = wizardData.targetPdsSupportEmail;
          }
          if (deactivatedDid) {
            deactivatedDid.textContent = wizardData.did;
          }
        } else {
          deactivatedHelp.style.display = 'none';
        }
      }
    }

    function hideTargetPasswordSection() {
      const targetPasswordGroup = document.getElementById('target-password-group');
      targetPasswordGroup.style.display = 'none';
      wizardData.targetCredentialsVerified = false;
      wizardData.newPdsAccessToken = null;
      wizardData.newPdsRefreshToken = null;
      wizardData.accountExistsOnTarget = false;
      wizardData.accountDeactivatedOnTarget = false;
    }

    function updatePdsConsentUI() {
      const consentGroup = document.getElementById('pds-consent-group');
      const consentCheckbox = document.getElementById('pds-consent-checkbox');
      const consentLabel = document.getElementById('pds-consent-label');
      const consentDescription = document.getElementById('pds-consent-description');
      const pdsLinksGroup = document.getElementById('pds-links-group');
      const pdsLinksContent = document.getElementById('pds-links-content');
      const hasTos = wizardData.pdsTosUrl;
      const hasPrivacy = wizardData.pdsPrivacyPolicyUrl;

      // Reset both UI elements
      consentGroup.style.display = 'none';
      consentCheckbox.checked = false;
      pdsLinksGroup.style.display = 'none';

      if (!hasTos && !hasPrivacy) return;

      // Build hostname for display
      try {
        var pdsHostname = new URL(wizardData.pdsVerifiedHost).hostname;
      } catch(e) {
        var pdsHostname = wizardData.pdsVerifiedHost;
      }

      // Build link elements
      var links = [];
      if (hasTos) {
        links.push('<a href="' + wizardData.pdsTosUrl + '" target="_blank" rel="noopener">' + i18n('pds_consent_tos') + '</a>');
      }
      if (hasPrivacy) {
        links.push('<a href="' + wizardData.pdsPrivacyPolicyUrl + '" target="_blank" rel="noopener">' + i18n('pds_consent_privacy') + '</a>');
      }

      if (wizardData.pdsIsEurosky) {
        // Eurosky PDS: show consent checkbox (required to proceed)
        consentGroup.style.display = 'block';
        consentDescription.textContent = i18n('pds_consent_description', {pds: pdsHostname});

        if (hasTos && hasPrivacy) {
          consentLabel.innerHTML = i18n('pds_consent_both', {tos_link: links[0], privacy_link: links[1]});
        } else {
          consentLabel.innerHTML = i18n('pds_consent_single', {link: links[0]});
        }
      } else {
        // Third-party PDS: show links as informational only (no checkbox)
        pdsLinksGroup.style.display = 'block';
        pdsLinksContent.innerHTML = i18n('pds_links_info', {pds: pdsHostname}) + ' ' + links.join(' · ');
      }
    }

    // PDS selection
    pdsSelect.addEventListener('change', function(e) {
      const selectedValue = e.target.value;
      const customGroup = document.getElementById('custom-pds-group');
      const inviteGroup = document.getElementById('invite-code-group');
      const status = document.getElementById('pds-status');

      wizardData.pdsVerified = false;
      wizardData.pdsVerifiedHost = null;
      wizardData.pdsTosUrl = null;
      wizardData.pdsPrivacyPolicyUrl = null;
      wizardData.pdsIsEurosky = false;
      hideTargetPasswordSection();
      updatePdsConsentUI();

      if (selectedValue === 'custom') {
        customGroup.style.display = 'block';
        customPdsField.value = '';
        customPdsField.focus();
        inviteGroup.style.display = 'none';
        status.style.display = 'none';
      } else if (selectedValue) {
        customGroup.style.display = 'none';
        customPdsField.value = selectedValue;
        checkPdsRequirements(selectedValue, status, inviteGroup, function(success) {
          if (success) {
            // After PDS check succeeds, check if account already exists on target
            checkAccountExistsOnTarget(selectedValue, function(exists) {
              if (exists) {
                showTargetPasswordSection(selectedValue);
              }
            });
          }
        });
      } else {
        customGroup.style.display = 'none';
        inviteGroup.style.display = 'none';
        status.style.display = 'none';
      }
    });

    customPdsField.addEventListener('input', function() {
      if (pdsSelect.value === 'custom') {
        wizardData.pdsVerified = false;
        wizardData.pdsVerifiedHost = null;
        wizardData.pdsTosUrl = null;
        wizardData.pdsPrivacyPolicyUrl = null;
        wizardData.pdsIsEurosky = false;
        updatePdsConsentUI();
      }
    });

    function checkPdsRequirements(pdsHost, statusElement, inviteGroup, callback) {
      showStatus(statusElement, i18n('checking_requirements'), 'info');

      fetch('/migrations/check_pds', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
        },
        body: JSON.stringify({ pds_host: pdsHost })
      })
      .then(response => response.json())
      .then(data => {
        if (data.error) {
          showStatus(statusElement, data.error, 'error');
          inviteGroup.style.display = 'none';
          wizardData.pdsVerified = false;
          if (callback) callback(false);
          return;
        }

        showStatus(statusElement, i18n('server_verified'), 'success');

        wizardData.availableDomains = data.available_user_domains || [];
        wizardData.pdsContactEmail = data.contact_email || null;
        wizardData.pdsVerified = true;
        wizardData.pdsVerifiedHost = pdsHost;

        // PDS capabilities from describeServer
        wizardData.pdsCaptchaRequired = data.captcha_required || false;
        wizardData.pdsCaptchaSiteKey = data.captcha_site_key || null;
        wizardData.pdsCaptchaUnsupported = data.captcha_unsupported || false;
        wizardData.pdsTosUrl = data.tos_url || null;
        wizardData.pdsPrivacyPolicyUrl = data.privacy_policy_url || null;
        wizardData.pdsIsEurosky = data.is_eurosky || false;
        updatePdsConsentUI();

        if (data.invite_code_required) {
          inviteGroup.style.display = 'block';
          inviteCodeField.required = true;
          inviteCodeField.setAttribute('required', 'required');
        } else {
          inviteGroup.style.display = 'none';
          inviteCodeField.required = false;
          inviteCodeField.removeAttribute('required');
        }
        if (callback) callback(true);
      })
      .catch(error => {
        showStatus(statusElement, i18n('failed_verify_pds'), 'error');
        inviteGroup.style.display = 'none';
        wizardData.pdsVerified = false;
        if (callback) callback(false);
      });
    }

    // STEP 4: New Handle
    const newHandleInput = document.getElementById('new-handle-input');
    const newHandleSuffix = document.getElementById('new-handle-suffix');
    const preservationSection = document.getElementById('handle-preservation-section');
    const newHandleSection = document.getElementById('new-handle-section');
    const preserveCheckbox = document.getElementById('preserve-handle-checkbox');
    const customHandleDisplay = document.getElementById('custom-handle-display');

    function setupStep4() {
      // Existing account on target: show handle as read-only
      if (wizardData.accountExistsOnTarget && wizardData.existingHandleOnTarget) {
        preservationSection.style.display = 'none';
        newHandleSection.style.display = 'block';
        newHandleInput.value = wizardData.existingHandleOnTarget;
        newHandleSuffix.textContent = '';
        newHandleInput.readOnly = true;
        newHandleInput.style.paddingRight = '12px';
      } else if (wizardData.canPreserveHandle && wizardData.handleType === 'dns_verified') {
        // Custom domain: offer to keep it
        preservationSection.style.display = 'block';
        customHandleDisplay.textContent = '@' + wizardData.oldHandle;
        var domainHelp = document.getElementById('custom-domain-help-text');
        if (domainHelp) domainHelp.innerHTML = i18n('custom_domain_help', {handle: '<strong>@' + wizardData.oldHandle + '</strong>'});
        preserveCheckbox.checked = true;
        newHandleSection.style.display = 'none';
        newHandleInput.readOnly = false;
        newHandleInput.style.paddingRight = '200px';
      } else {
        // New account: editable handle, pre-filled with old handle prefix
        preservationSection.style.display = 'none';
        newHandleSection.style.display = 'block';
        newHandleInput.readOnly = false;
        newHandleInput.style.paddingRight = '200px';

        if (wizardData.availableDomains.length > 0) {
          const domain = wizardData.availableDomains[0];
          newHandleSuffix.textContent = domain.startsWith('.') ? domain : '.' + domain;
        } else {
          const pdsUrl = new URL(wizardData.pdsHost);
          newHandleSuffix.textContent = '.' + pdsUrl.hostname;
        }

        // Pre-fill with the username part of the old handle
        const oldHandleParts = (wizardData.oldHandle || '').split('.');
        newHandleInput.value = oldHandleParts.length > 0 ? oldHandleParts[0] : '';
        newHandleInput.focus();
      }
    }

    preserveCheckbox.addEventListener('change', function(e) {
      if (e.target.checked) {
        newHandleSection.style.display = 'none';
      } else {
        newHandleSection.style.display = 'block';

        if (wizardData.availableDomains.length > 0) {
          const domain = wizardData.availableDomains[0];
          newHandleSuffix.textContent = domain.startsWith('.') ? domain : '.' + domain;
        } else {
          const pdsUrl = new URL(wizardData.pdsHost);
          newHandleSuffix.textContent = '.' + pdsUrl.hostname;
        }
        newHandleInput.value = '';
        newHandleInput.focus();
      }
    });

    document.getElementById('step4-back').addEventListener('click', function(e) {
      e.preventDefault();
      showStep(3);
    });

    document.getElementById('step4-next').addEventListener('click', function(e) {
      e.preventDefault();

      const btn = e.target;
      const status = document.getElementById('step4-status');
      let fullHandle;

      // Existing account: use the handle as-is, skip all checks
      if (wizardData.accountExistsOnTarget && wizardData.existingHandleOnTarget) {
        fullHandle = wizardData.existingHandleOnTarget;
        document.getElementById('migration_new_handle').value = fullHandle;
        showStatus(status, i18n('using_existing_handle'), 'success');

        setTimeout(() => {
          showStep(5);
          setupStep5();
        }, 500);
        return;
      }

      if (wizardData.canPreserveHandle && preserveCheckbox.checked) {
        fullHandle = wizardData.oldHandle;
        document.getElementById('migration_new_handle').value = fullHandle;
        showStatus(status, i18n('keeping_custom_handle'), 'success');

        setTimeout(() => {
          showStep(5);
          setupStep5();
        }, 500);
        return;
      }

      const handleUsername = newHandleInput.value.trim();
      if (!handleUsername) {
        alert(i18n('enter_handle_short'));
        return;
      }

      const suffix = newHandleSuffix.textContent;
      const userEndsWithDot = handleUsername.endsWith('.');
      const suffixStartsWithDot = suffix.startsWith('.');

      if (userEndsWithDot && suffixStartsWithDot) {
        fullHandle = handleUsername.slice(0, -1) + suffix;
      } else if (!userEndsWithDot && !suffixStartsWithDot) {
        fullHandle = handleUsername + '.' + suffix;
      } else {
        fullHandle = handleUsername + suffix;
      }

      btn.disabled = true;
      btn.textContent = i18n('checking_availability');
      showStatus(status, i18n('checking_handle'), 'info');

      fetch('/migrations/check_handle', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
        },
        body: JSON.stringify({
          handle: fullHandle,
          pds_host: wizardData.pdsHost,
          did: wizardData.did
        })
      })
      .then(response => response.json())
      .then(data => {
        btn.disabled = false;
        btn.textContent = i18n('continue');

        if (data.error) {
          showStatus(status, data.error, 'error');
          return;
        }

        if (!data.available) {
          showStatus(status, i18n('handle_taken'), 'error');
          return;
        }

        // Skip DID check if account was already verified in Step 3 (migration_in)
        if (wizardData.accountExistsOnTarget && wizardData.targetCredentialsVerified) {
          showStatus(status, i18n('all_checks_passed'), 'success');
          document.getElementById('migration_new_handle').value = fullHandle;

          setTimeout(() => {
            showStep(5);
            setupStep5();
          }, 500);
          return;
        }

        showStatus(status, i18n('handle_available_checking'), 'info');
        btn.disabled = true;
        btn.textContent = i18n('checking_existing_accounts');

        fetch('/migrations/check_did_on_pds', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
          },
          body: JSON.stringify({
            did: wizardData.did,
            pds_host: wizardData.pdsHost
          })
        })
        .then(response => response.json())
        .then(didData => {
          btn.disabled = false;
          btn.textContent = i18n('continue');

          if (didData.error) {
            showStatus(status, didData.error, 'error');
            return;
          }

          if (didData.exists) {
            const supportEmail = wizardData.pdsContactEmail || '<%= ENV.fetch('SUPPORT_EMAIL', 'support@example.com') %>';
            const errorMessage = `
              <div class="text-start lh-lg">
                <strong>${i18n('account_exists_title')}</strong><br><br>
                <strong>${i18n('account_exists_what', {pds: wizardData.pdsHost})}</strong><br><br>

                ${i18n('account_exists_do')}
                <ul class="ms-3">
                  <li>${i18n('account_exists_reset')} <a href="${wizardData.pdsHost.replace(/\/$/, '')}/.well-known/change-password" target="_blank" rel="noopener">${wizardData.pdsHost.replace(/\/$/, '')}/.well-known/change-password</a></li>
                  <li>${i18n('account_exists_contact', {email: supportEmail})}</li>
                  <li>${i18n('account_exists_did')} <code>${wizardData.did}</code></li>
                </ul>
              </div>
            `;

            status.className = 'lookup-status lookup-error mt-3';
            status.innerHTML = errorMessage;
            status.style.display = 'block';
            return;
          }

          showStatus(status, i18n('all_checks_passed'), 'success');
          document.getElementById('migration_new_handle').value = fullHandle;

          setTimeout(() => {
            showStep(5);
            setupStep5();
          }, 500);
        })
        .catch(didError => {
          btn.disabled = false;
          btn.textContent = i18n('continue');
          showStatus(status, i18n('failed_check_existing') + didError.message, 'error');
        });
      })
      .catch(error => {
        btn.disabled = false;
        btn.textContent = i18n('continue');
        showStatus(status, i18n('failed_check_availability'), 'error');
      });
    });

    // STEP 5: Summary
    function setupStep5() {
      document.getElementById('summary-handle').textContent = handleField.value;
      document.getElementById('summary-email').textContent = emailField.value;
      document.getElementById('summary-pds').textContent = wizardData.pdsHost;
      document.getElementById('summary-new-handle').textContent = document.getElementById('migration_new_handle').value;
      document.getElementById('confirm-email-notice').innerHTML = i18n('confirm_email_html', {email: emailField.value});

      if (inviteCodeField.value.trim()) {
        document.getElementById('summary-invite-row').style.display = 'table-row';
        document.getElementById('summary-invite').textContent = inviteCodeField.value;
      } else {
        document.getElementById('summary-invite-row').style.display = 'none';
      }
    }

    document.getElementById('step5-back').addEventListener('click', function(e) {
      e.preventDefault();
      showStep(4);
    });

    // Handle form submission
    form.addEventListener('submit', function(event) {
      event.preventDefault();

      const currentStep = document.querySelector('.wizard-step.active');
      if (!currentStep || currentStep.id !== 'step-5') {
        return;
      }

      const acknowledgeCheckbox = document.getElementById('acknowledge-no-usage');
      if (!acknowledgeCheckbox.checked) {
        alert(i18n('confirm_no_usage'));
        acknowledgeCheckbox.focus();
        return;
      }

      document.getElementById('migration_old_access_token').value = wizardData.accessToken || '';
      document.getElementById('migration_old_refresh_token').value = wizardData.refreshToken || '';
      document.getElementById('migration_new_access_token').value = wizardData.newPdsAccessToken || '';
      document.getElementById('migration_new_refresh_token').value = wizardData.newPdsRefreshToken || '';
      // The destination host must be the one the wizard verified — never whatever a
      // password manager or browser autofill left in the (hidden) custom-host input.
      // Seen in production: the form posted the user's handle as the destination.
      if (wizardData.pdsHost) customPdsField.value = wizardData.pdsHost;
      document.getElementById('migration_target_pds_contact_email').value = wizardData.pdsContactEmail || '';
      document.getElementById('pds_tos_url').value = wizardData.pdsTosUrl || '';
      document.getElementById('pds_privacy_policy_url').value = wizardData.pdsPrivacyPolicyUrl || '';
      document.getElementById('pds_consent_value').value = document.getElementById('pds-consent-checkbox').checked ? '1' : '0';
      document.getElementById('pds_captcha_required').value = wizardData.pdsCaptchaRequired ? '1' : '0';
      document.getElementById('pds_captcha_site_key').value = wizardData.pdsCaptchaSiteKey || '';

      passwordField.value = '';
      const targetPwdField = document.getElementById('target-pds-password');
      if (targetPwdField) targetPwdField.value = '';

      form.submit();
    });
  });
</script>
<% end %>

<div class="new-migration-container">
  <div class="new-migration-content">
    <div class="new-migration-header">
      <h1><%= EuroskyConfig::SITE_NAME %></h1>
      <p><%= EuroskyConfig::SITE_SUBTITLE %></p>
    </div>

    <% if @migration&.errors&.any? %>
      <div class="alert alert-danger" role="alert">
        <h6 class="alert-heading fw-bold"><%= t('migrations.new.errors_heading') %></h6>
        <ul class="mb-0">
          <% @migration.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @migration, url: migrations_path, local: true, html: { novalidate: true } do |f| %>
      <!-- Hidden fields for authentication tokens -->
      <%= hidden_field_tag 'migration[old_access_token]', '', id: 'migration_old_access_token' %>
      <%= hidden_field_tag 'migration[old_refresh_token]', '', id: 'migration_old_refresh_token' %>
      <%= hidden_field_tag 'migration[target_pds_contact_email]', '', id: 'migration_target_pds_contact_email' %>
      <!-- Hidden fields for PDS legal URLs (populated from describeServer) -->
      <%= hidden_field_tag 'pds_tos_url', '', id: 'pds_tos_url' %>
      <%= hidden_field_tag 'pds_privacy_policy_url', '', id: 'pds_privacy_policy_url' %>
      <%= hidden_field_tag 'pds_consent', '0', id: 'pds_consent_value' %>
      <%= hidden_field_tag 'pds_captcha_required', '0', id: 'pds_captcha_required' %>
      <%= hidden_field_tag 'pds_captcha_site_key', '', id: 'pds_captcha_site_key' %>

      <!-- Progress Bar -->
      <div class="step-progress-bar">
        <div class="progress-indicator" id="progress-bar" style="width: 0%;"></div>
      </div>

      <!-- Progress Indicator -->
      <div class="wizard-progress mb-4">
        <div id="progress-1" class="wizard-progress-step">
          <div class="wizard-progress-circle">1</div>
          <div class="wizard-progress-label"><%= t('migrations.new.progress.account') %></div>
        </div>
        <div id="progress-2" class="wizard-progress-step">
          <div class="wizard-progress-circle">2</div>
          <div class="wizard-progress-label"><%= t('migrations.new.progress.email') %></div>
        </div>
        <div id="progress-3" class="wizard-progress-step">
          <div class="wizard-progress-circle">3</div>
          <div class="wizard-progress-label"><%= t('migrations.new.progress.destination') %></div>
        </div>
        <div id="progress-4" class="wizard-progress-step">
          <div class="wizard-progress-circle">4</div>
          <div class="wizard-progress-label"><%= t('migrations.new.progress.handle') %></div>
        </div>
        <div id="progress-5" class="wizard-progress-step">
          <div class="wizard-progress-circle">5</div>
          <div class="wizard-progress-label"><%= t('migrations.new.progress.review') %></div>
        </div>
      </div>

      <!-- STEP 1: Handle & Password -->
      <div id="step-1" class="wizard-step">
        <h2 class="mb-3"><%= t('migrations.new.step1.title') %></h2>

        <div class="mb-3">
          <%= f.label :old_handle, t('migrations.new.step1.handle_label'), class: "form-label" %>
          <%= f.text_field :old_handle, id: "migration_old_handle", placeholder: t('migrations.new.step1.handle_placeholder'), autocomplete: "username", class: "form-control" %>
          <div class="form-text"><%= t('migrations.new.step1.handle_help') %></div>
        </div>

        <div class="mb-3">
          <%= f.label :password, t('migrations.new.step1.password_label'), class: "form-label" %>
          <%= f.password_field :password, id: "migration_password", autocomplete: "current-password", class: "form-control" %>
          <div class="form-text"><%= t('migrations.new.step1.password_help') %></div>
        </div>

        <div id="step1-status" class="lookup-status"></div>

        <!-- Two-Factor Authentication -->
        <div id="two-factor-group" class="alert alert-warning border-start border-warning border-4 rounded-1 py-2 px-3 mb-3" style="display: none;">
          <div class="fw-semibold small mb-1" style="color: #92400e;"><%= t('migrations.new.step1.two_factor_title') %></div>
          <p class="small mb-2" style="color: #78350f;">
            <%= t('migrations.new.step1.two_factor_help') %>
          </p>
          <input type="text" id="two_factor_code" class="form-control form-control-lg text-center font-monospace" placeholder="<%= t('migrations.new.step1.two_factor_placeholder') %>" autocomplete="one-time-code" inputmode="numeric">
        </div>

        <div class="form-check mt-3 mb-0 small">
          <input type="checkbox" name="migration[legal_consent]" id="legal-consent"
                 class="form-check-input" value="1">
          <label class="form-check-label" for="legal-consent">
            <%= t('migrations.new.step1.legal_consent_html',
                  tos_url: EuroskyConfig::TERMS_OF_SERVICE_URL,
                  privacy_url: EuroskyConfig::PRIVACY_POLICY_URL) %>
          </label>
        </div>

        <div class="d-grid mt-3">
          <button type="button" id="step1-next" class="btn btn-lg btn-gradient"><%= t('migrations.new.step1.continue') %></button>
        </div>
      </div>

      <!-- STEP 2: Email -->
      <div id="step-2" class="wizard-step">
        <h2 class="mb-3"><%= t('migrations.new.step2.title') %></h2>

        <div class="mb-3">
          <%= f.label :email, t('migrations.new.step2.email_label'), class: "form-label" %>
          <%= f.email_field :email, id: "migration_email", placeholder: "you@example.com", autocomplete: "email", class: "form-control" %>
          <div class="form-text"><%= t('migrations.new.step2.email_help') %></div>
        </div>

        <div class="alert alert-warning border-start border-warning border-4 rounded-1 py-2 px-3 mb-3 small">
          <div class="form-check mb-0">
            <input type="checkbox" id="confirm-email-access" class="form-check-input">
            <label class="form-check-label" for="confirm-email-access" style="color: #78350f;">
              <%= t('migrations.new.step2.confirm_access') %>
            </label>
          </div>
        </div>

        <div class="d-flex gap-2 mt-4">
          <button type="button" id="step2-back" class="btn btn-secondary"><%= t('migrations.new.step2.back') %></button>
          <button type="button" id="step2-next" class="btn btn-lg btn-gradient flex-grow-1"><%= t('migrations.new.step2.continue') %></button>
        </div>
      </div>

      <!-- STEP 3: Destination PDS -->
      <div id="step-3" class="wizard-step">
        <h2 class="mb-3"><%= t('migrations.new.step3.title') %></h2>

        <div class="mb-3">
          <label for="pds-select" class="form-label"><%= t('migrations.new.step3.server_label') %></label>
          <select id="pds-select" class="form-select form-select-lg">
            <option value=""><%= t('migrations.new.step3.server_placeholder') %></option>
            <option value="https://eurosky.social"><%= t('migrations.new.step3.server_eurosky') %></option>
            <option value="https://blacksky.app"><%= t('migrations.new.step3.server_blacksky') %></option>
            <option value="https://myatproto.social"><%= t('migrations.new.step3.server_myatproto') %></option>
            <option value="https://bsky.social"><%= t('migrations.new.step3.server_bluesky') %></option>
            <option value="custom"><%= t('migrations.new.step3.server_custom') %></option>
          </select>
          <div class="form-text"><%= t('migrations.new.step3.server_help') %></div>
        </div>

        <div id="custom-pds-group" class="mb-3" style="display: none;">
          <%= f.label :new_pds_host, t('migrations.new.step3.custom_url_label'), class: "form-label" %>
          <%= f.text_field :new_pds_host, id: "migration_new_pds_host", placeholder: t('migrations.new.step3.custom_url_placeholder'), autocomplete: "off", class: "form-control" %>
          <div class="form-text"><%= t('migrations.new.step3.custom_url_help') %></div>
        </div>

        <div id="pds-status" class="lookup-status"></div>

        <div id="invite-code-group" class="mb-3" style="display: none;">
          <%= f.label :invite_code, t('migrations.new.step3.invite_code_label'), class: "form-label" %>
          <%= f.text_field :invite_code, id: "migration_invite_code", placeholder: t('migrations.new.step3.invite_code_placeholder'), autocomplete: "off", class: "form-control" %>
          <div class="form-text"><%= t('migrations.new.step3.invite_code_help') %></div>
        </div>

        <!-- Target PDS password (for existing account on target server) -->
        <div id="target-password-group" class="alert alert-info border-start border-info border-4 rounded-1 py-2 px-3 mt-3 mb-3" style="display: none;">
          <div class="fw-semibold small mb-1" style="color: #0c4a6e;"><%= t('migrations.new.step3.existing_account_title') %></div>
          <p class="small mb-2" style="color: #164e63;">
            <%= t('migrations.new.step3.existing_account_help') %>
          </p>
          <div class="mb-2">
            <label for="target-pds-password" class="form-label small"><%= t('migrations.new.step3.target_password_label') %></label>
            <input type="password" id="target-pds-password" class="form-control" placeholder="<%= t('migrations.new.step3.target_password_placeholder') %>" autocomplete="current-password">
          </div>
          <div id="target-2fa-group" class="mt-2" style="display: none;">
            <label for="target-2fa-code" class="form-label small"><%= t('migrations.new.step3.target_2fa_label') %></label>
            <input type="text" id="target-2fa-code" class="form-control form-control-lg text-center font-monospace" placeholder="<%= t('migrations.new.step1.two_factor_placeholder') %>" autocomplete="one-time-code" inputmode="numeric">
            <div class="form-text"><%= t('migrations.new.step3.target_2fa_help') %></div>
          </div>
          <div id="target-deactivated-help" class="mt-2 small" style="display: none; color: #78350f; background: #fef3c7; padding: 10px; border-radius: 4px;">
            <strong><%= t('migrations.new.step3.deactivated_notice') %></strong> <%= t('migrations.new.step3.deactivated_reason') %><br>
            <%= t('migrations.new.step3.deactivated_help') %>
            <ul class="mb-1 mt-1">
              <li><%= t('migrations.new.step3.deactivated_reset') %> <a id="target-deactivated-pwd-link" href="#" target="_blank" rel="noopener"></a></li>
              <li><span id="target-deactivated-contact-text"></span> <code id="target-deactivated-did"></code></li>
            </ul>
          </div>
          <div id="target-password-status" class="lookup-status"></div>
        </div>

        <!-- PDS Terms of Service / Privacy Policy consent (Eurosky PDS only) -->
        <div id="pds-consent-group" class="alert alert-info border-start border-primary border-4 rounded-1 py-2 px-3 mt-3 mb-3 small" style="display: none;">
          <div class="fw-semibold mb-1" style="color: #0c4a6e;"><%= t('migrations.new.step3.pds_consent_title') %></div>
          <p class="mb-2" style="color: #164e63;" id="pds-consent-description"></p>
          <div class="form-check mb-0">
            <input type="checkbox" id="pds-consent-checkbox" class="form-check-input">
            <label class="form-check-label" for="pds-consent-checkbox" id="pds-consent-label"></label>
          </div>
        </div>

        <!-- PDS legal links (informational, for non-Eurosky PDSs) -->
        <div id="pds-links-group" class="text-muted small mt-3 mb-3" style="display: none;">
          <span id="pds-links-content"></span>
        </div>

        <!-- Hidden fields for target PDS tokens -->
        <%= hidden_field_tag 'migration[new_access_token]', '', id: 'migration_new_access_token' %>
        <%= hidden_field_tag 'migration[new_refresh_token]', '', id: 'migration_new_refresh_token' %>

        <div id="step3-error" class="lookup-status"></div>

        <div class="d-flex gap-2 mt-4">
          <button type="button" id="step3-back" class="btn btn-secondary"><%= t('migrations.new.step3.back') %></button>
          <button type="button" id="step3-next" class="btn btn-lg btn-gradient flex-grow-1"><%= t('migrations.new.step3.continue') %></button>
        </div>
      </div>

      <!-- STEP 4: New Handle -->
      <div id="step-4" class="wizard-step">
        <h2 class="mb-3"><%= t('migrations.new.step4.title') %></h2>

        <!-- Custom Domain Handle Preservation Option -->
        <div id="handle-preservation-section" class="alert alert-info border-start border-info border-4 rounded-1 py-2 px-3 mb-3 small" style="display: none;">
          <div class="fw-semibold mb-1" style="color: #075985;"><%= t('migrations.new.step4.custom_domain_title') %></div>
          <p class="mb-2" style="color: #075985;" id="custom-domain-help-text">
          </p>
          <div class="form-check mb-0">
            <input type="checkbox" id="preserve-handle-checkbox" checked class="form-check-input">
            <label class="form-check-label fw-semibold" for="preserve-handle-checkbox"><%= t('migrations.new.step4.keep_handle') %></label>
          </div>
        </div>

        <!-- Regular Handle Input -->
        <div id="new-handle-section" class="mb-3">
          <label for="new-handle-input" class="form-label"><%= t('migrations.new.step4.new_handle_label') %></label>
          <div class="position-relative">
            <input type="text" id="new-handle-input" class="form-control" placeholder="<%= t('migrations.new.step4.new_handle_placeholder') %>" style="padding-right: 200px;">
            <span id="new-handle-suffix" class="handle-suffix"></span>
          </div>
          <div class="form-text"><%= t('migrations.new.step4.new_handle_help') %></div>
          <%= f.hidden_field :new_handle, id: "migration_new_handle" %>
        </div>

        <div id="step4-status" class="lookup-status"></div>

        <div class="d-flex gap-2 mt-4">
          <button type="button" id="step4-back" class="btn btn-secondary"><%= t('migrations.new.step4.back') %></button>
          <button type="button" id="step4-next" class="btn btn-lg btn-gradient flex-grow-1"><%= t('migrations.new.step4.continue') %></button>
        </div>
      </div>

      <!-- STEP 5: Summary & Confirm -->
      <div id="step-5" class="wizard-step">
        <h2 class="mb-3"><%= t('migrations.new.step5.title') %></h2>

        <table class="table mb-4">
          <tr>
            <td class="fw-semibold"><%= t('migrations.new.step5.current_handle') %></td>
            <td id="summary-handle"></td>
          </tr>
          <tr>
            <td class="fw-semibold"><%= t('migrations.new.step5.email') %></td>
            <td id="summary-email"></td>
          </tr>
          <tr>
            <td class="fw-semibold"><%= t('migrations.new.step5.destination_server') %></td>
            <td id="summary-pds"></td>
          </tr>
          <tr>
            <td class="fw-semibold"><%= t('migrations.new.step5.new_handle') %></td>
            <td class="fw-bold text-primary" id="summary-new-handle"></td>
          </tr>
          <tr id="summary-invite-row" style="display: none;">
            <td class="fw-semibold"><%= t('migrations.new.step5.invite_code') %></td>
            <td id="summary-invite"></td>
          </tr>
        </table>

        <div class="alert alert-success border-start border-success border-4 rounded-1 py-2 px-3 mb-3 small">
          <div class="form-check mb-0">
            <%= f.check_box :create_backup_bundle, id: "migration_create_backup_bundle", checked: true, class: "form-check-input" %>
            <label class="form-check-label fw-semibold" for="migration_create_backup_bundle">
              <%= t('migrations.new.step5.create_backup') %>
            </label>
            <div class="text-body-secondary mt-1">
              <%= t('migrations.new.step5.backup_help') %>
            </div>
          </div>
        </div>

        <div class="alert alert-info border-start border-primary border-4 rounded-1 py-2 px-3 mb-3 small" id="confirm-email-notice">
        </div>

        <div class="alert alert-warning border-start border-warning border-4 rounded-1 py-2 px-3 mb-3 small">
          <div class="fw-semibold mb-1" style="color: #92400e;"><%= t('migrations.new.step5.no_usage_title') %></div>
          <p class="mb-2" style="color: #78350f;">
            <%= t('migrations.new.step5.no_usage_help') %>
          </p>
          <div class="form-check mb-0">
            <input type="checkbox" id="acknowledge-no-usage" class="form-check-input" required>
            <label class="form-check-label fw-semibold" for="acknowledge-no-usage" style="color: #92400e;">
              <%= t('migrations.new.step5.acknowledge') %>
            </label>
          </div>
        </div>

        <div class="d-flex gap-2 mt-4">
          <button type="button" id="step5-back" class="btn btn-secondary"><%= t('migrations.new.step5.back') %></button>
          <%= f.submit t('migrations.new.step5.continue'), class: "btn btn-lg btn-gradient flex-grow-1", id: "start-migration-btn" %>
        </div>
      </div>

    <% end %>

    <!-- Legal Links -->
    <!--
    <% if EuroskyConfig::PRIVACY_POLICY_URL.present? || EuroskyConfig::TERMS_OF_SERVICE_URL.present? %>
      <div class="text-center mt-3 small text-muted">
        <% if EuroskyConfig::PRIVACY_POLICY_URL.present? %>
          <a href="<%= EuroskyConfig::PRIVACY_POLICY_URL %>" target="_blank" rel="noopener" class="text-muted"><%= t('layouts.privacy_policy') %></a>
        <% end %>
        <% if EuroskyConfig::PRIVACY_POLICY_URL.present? && EuroskyConfig::TERMS_OF_SERVICE_URL.present? %>
          <span class="mx-1">·</span>
        <% end %>
        <% if EuroskyConfig::TERMS_OF_SERVICE_URL.present? %>
          <a href="<%= EuroskyConfig::TERMS_OF_SERVICE_URL %>" target="_blank" rel="noopener" class="text-muted"><%= t('layouts.terms_of_service') %></a>
        <% end %>
      </div>
    <% end %>
    -->

    <!-- Image Attribution -->
    <div class="text-center mt-3 small text-muted">
      <%= t('layouts.background_attribution') %> <a href="https://commons.wikimedia.org/wiki/File:GMC_U-Haul_truck_front_1.JPG" target="_blank" rel="noopener" class="text-muted">GMC U-Haul truck</a> <%= t('layouts.background_attribution_by') %> <a href="https://commons.wikimedia.org/wiki/User:BrokenSphere" target="_blank" rel="noopener" class="text-muted">BrokenSphere</a>, <a href="https://creativecommons.org/licenses/by/3.0" target="_blank" rel="noopener" class="text-muted">CC BY 3.0</a>
    </div>
  </div>
</div>
